{
  "name": "epic-css",
  "version": "0.14.5",
  "description": "CSS library with prebuild utilities",
  "main": "src/index.scss",
  "scripts": {
    "test": "node test/palette.cjs && node test/spacers.cjs && node test/build.cjs",
    "prepublishOnly": "npm test",
    "build": "node scripts/build.cjs",
    "epic-compile": "node scripts/build.cjs",
    "epic-light": "node ./node_modules/epic-css/src/epic-light.js",
    "epic-build": "node ./node_modules/epic-css/src/epic-build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremyfaucher/epic-css.git"
  },
  "keywords": [
    "CSS"
  ],
  "author": {
    "name": "Jeremy Faucher",
    "email": "hello.design2seo@gmail.com",
    "url": "https://design2seo.com/"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jeremyfaucher/epic-css/issues"
  },
  "homepage": "https://epiccss.com",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "postcss": "^8.4.35",
    "sass": "^1.70.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "src/**/*.scss",
    "src/epic-build.js",
    "src/epic-light.js",
    "test/palette.cjs",
    "test/spacers.cjs",
    "test/build.cjs",
    "scripts/build.cjs",
    "CHANGELOG.md"
  ]
}
